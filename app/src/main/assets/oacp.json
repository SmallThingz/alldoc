{
  "oacpVersion": "0.3",
  "appId": "__APPLICATION_ID__",
  "displayName": "AllDoc",
  "appDomains": [
    "documents"
  ],
  "appKeywords": [
    "PDF",
    "document",
    "Markdown",
    "spreadsheet",
    "presentation",
    "ebook"
  ],
  "capabilities": [
    {
      "id": "read_document",
      "description": "Extract readable text from a supported document.",
      "domain": "documents",
      "parameters": [
        {
          "name": "uri",
          "type": "string",
          "required": false,
          "description": "Caller-readable content URI. Grant AllDoc read access with ClipData; omit to choose a document."
        },
        {
          "name": "recipient_package",
          "type": "string",
          "required": false,
          "description": "Reply app package for launches without a platform-authenticated caller; the user selects a document before sharing."
        },
        {
          "name": "display_name",
          "type": "string",
          "required": false,
          "description": "Optional filename, at most 256 characters."
        },
        {
          "name": "mime_type",
          "type": "string",
          "required": false,
          "description": "Optional MIME type, at most 128 characters."
        },
        {
          "name": "password",
          "type": "string",
          "required": false,
          "description": "Optional PDF password, at most 256 characters; never include it in logs."
        }
      ],
      "confirmation": "never",
      "visibility": "public",
      "requiresForeground": true,
      "completionMode": "async_result",
      "sensitivity": "high",
      "idempotent": true,
      "sideEffects": "Creates a bounded temporary result; does not change the source or reading history.",
      "resultTransport": {
        "android": {
          "type": "broadcast",
          "action": "org.oacp.ACTION_RESULT"
        }
      },
      "resultSchema": {
        "type": "object",
        "required": [
          "uri",
          "mimeType",
          "bytes",
          "format",
          "fidelity",
          "warnings",
          "page",
          "continuous"
        ],
        "properties": {
          "uri": {
            "type": "string",
            "description": "Read-granted content URI, at most one hour or until cache eviction."
          },
          "mimeType": {
            "type": "string"
          },
          "bytes": {
            "type": "integer",
            "maximum": 33554432
          },
          "format": {
            "const": "text"
          },
          "fidelity": {
            "type": "string"
          },
          "warnings": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "page": {
            "type": "integer"
          },
          "continuous": {
            "type": "boolean",
            "description": "True when the source is one continuous logical page, such as Markdown."
          }
        }
      },
      "errorCodes": [
        "invalid_parameters",
        "missing_parameters",
        "not_authorized",
        "not_authenticated",
        "unsupported_state",
        "cancelled",
        "internal_error"
      ],
      "invoke": {
        "android": {
          "type": "activity",
          "action": "__APPLICATION_ID__.oacp.ACTION_READ_DOCUMENT",
          "extrasMapping": {
            "uri": "uri",
            "recipient_package": "recipient_package",
            "display_name": "display_name",
            "mime_type": "mime_type",
            "password": "password"
          }
        }
      }
    },
