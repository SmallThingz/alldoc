    {
      "id": "render_page",
      "description": "Render one document page as a PNG in its original colors.",
      "domain": "documents",
      "parameters": [
        {
          "name": "uri",
          "type": "string",
          "required": false,
          "description": "Caller-readable content URI. Grant AllDoc read access with ClipData; omit to choose a document."
