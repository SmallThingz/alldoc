          "description": "Optional PDF password, at most 256 characters; never include it in logs."
        },
        {
          "name": "page",
          "type": "integer",
          "required": false,
          "description": "Zero-based page index.",
          "default": 0,
          "minimum": 0,
          "maximum": 99999
        },
        {
          "name": "width",
          "type": "integer",
          "required": false,
          "description": "Target pixel width; bounded engines may return a smaller image.",
          "default": 1200,
          "minimum": 64,
          "maximum": 2048
