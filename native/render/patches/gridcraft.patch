+/// Nonpaginated worksheet viewport in sheet pixels at 96dpi. Reuses the print renderer's
+/// cells, merges, wrapping, charts and images, without print areas/margins/title repetition.
+#[cfg(feature = "raster")]
+pub fn render_sheet_region(wb: &Workbook, sheet: usize, rows: &LineIndex, cols: &LineIndex,
+    cf: &mut Option<crate::cf::CfCache>, x: f64, y: f64, width: u32, height: u32, scale: f64,
+    max_rows: u32, max_cols: u32) -> std::result::Result<gridcraft_pdf::RasterImage, String> {
+    if ![x, y, scale].iter().all(|v| v.is_finite()) || x < 0.0 || y < 0.0 || !(0.0625..=32.0).contains(&scale)
+        || max_rows == 0 || max_cols == 0 {
+        return Err("Invalid worksheet viewport".into());
+    }
+    let sh = wb.sheet(sheet).ok_or("Worksheet unavailable")?;
+    let r0 = rows.at(y).min(max_rows - 1);
+    let r1 = rows.at(y + height as f64 / scale).min(max_rows - 1);
+    let c0 = cols.at(x).min(max_cols - 1);
+    let c1 = cols.at(x + width as f64 / scale).min(max_cols - 1);
+    // Nearest nonempty neighbours can overflow into the viewport from either side.
+    // Sparse row lookup avoids walking blank cells; objects still use actual viewport bounds.
+    let mut first_col = c0;
+    let mut last_col = c1;
+    for row in r0..=r1 {
+        if c0 > 0 {
+            if let Some((col, _)) = sh.cells.row(row, 0, c0 - 1).filter(|(_, c)| !c.value.is_empty()).last() {
+                first_col = first_col.min(col);
+            }
+        }
+        if c1 + 1 < max_cols {
+            if let Some((col, _)) = sh.cells.row(row, c1 + 1, max_cols - 1).find(|(_, c)| !c.value.is_empty()) {
+                last_col = last_col.max(col);
+            }
+        }
+    }
+    let xs = (first_col..=last_col + 1).map(|c| ((cols.start(c) - x) * scale) as f32).collect();
+    let ys = (r0..=r1 + 1).map(|r| ((rows.start(r) - y) * scale) as f32).collect();
+    let block = Block { wb, si: sheet, sh, rows: (r0, r1), cols: (first_col, last_col), xs, ys,
+        k: scale as f32, scale: (scale / PX_TO_PT as f64) as f32, axes: Some((rows, cols)) };
+    let mut doc = PdfDoc::new_raster(width, height, 1.0)?;
+    let pg = doc.add_page(width as f32, height as f32);
+    pg.save();
+    pg.clip_rect(0.0, 0.0, width as f32, height as f32);
+    draw_block(pg, &block, sh.show_gridlines, cf);
+    draw_objects(pg, wb, sheet, sh, &block, Some((x, y, x + width as f64 / scale, y + height as f64 / scale)));
+    pg.restore();
+    doc.finish_raster()
+}
