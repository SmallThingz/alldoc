+pub fn render_raster(wb: &Workbook, layouts: &[SheetLayout], file: &str, path: &str,
+    width: u32, height: u32, scale: f64, print_page: usize, print_pages: usize) -> std::result::Result<gridcraft_pdf::RasterImage, String> {
+    if layouts.iter().map(|l| l.pages.len()).sum::<usize>() != 1 {
+        return Err("Worksheet raster requires one selected print page".into());
+    }
+    if print_page == 0 || print_page > print_pages || print_pages > MAX_PAGES {
+        return Err("Worksheet print page context is out of range".into());
