+/// Renders one selected print page using the same layout and vector drawing traversal.
+/// `print_page` is the original one-based page in the full print order, and `print_pages`
+/// is that full layout's page count. Header/footer offsets (`&P+n`/`&P-n`) are still applied
+/// by the existing expander; selecting a page must not reset its footer to 1/1.
+/// The native reader keeps its existing process cancellation and PNG wire format.
+#[cfg(feature = "raster")]
+pub fn render_raster(wb: &Workbook, layouts: &[SheetLayout], file: &str, path: &str,
+    width: u32, height: u32, scale: f64, print_page: usize, print_pages: usize) -> std::result::Result<gridcraft_pdf::RasterImage, String> {
+    if layouts.iter().map(|l| l.pages.len()).sum::<usize>() != 1 {
+        return Err("Worksheet raster requires one selected print page".into());
+    }
+    if print_page == 0 || print_page > print_pages || print_pages > MAX_PAGES {
+        return Err("Worksheet print page context is out of range".into());
+    }
+    let mut doc = PdfDoc::new_raster(width, height, scale)?;
+    draw_document(wb, layouts, file, path, &mut doc, Some((print_page, print_pages)));
+    doc.finish_raster()
+}
