+//! Optional bounded print raster target. Layout remains in GridCraft's print traversal;
+//! text uses the same pinned shaper/font database and colour-glyph renderer as WordCraft.
+use std::{collections::HashMap, sync::Arc};
+use unicode_bidi::BidiInfo;
+use unicode_segmentation::UnicodeSegmentation;
+use vello_cpu::{RenderContext, Resources, Pixmap, kurbo::{Affine, BezPath, Rect, Shape, Stroke, Join, Cap}, peniko};
+use wordcraft_fonts::{FaceRef, FontDb};
+use super::{Font, Rgb, MAX_PAGE_CONTENT, MAX_IMAGE_PIXELS};
+
+/// Premultiplied RGBA, top-left origin. Caller performs its existing PNG encoding.
+pub struct RasterImage {
+    pub width: u32,
+    pub height: u32,
+    pub pixels: Vec<u8>,
+}
+
+// Bound a single shaping allocation independently of the aggregate drawing budget.
+const MAX_TEXT_BYTES: usize = 256 * 1024;
+fn scalar(v: f32) -> f64 { if v.is_finite() { v.clamp(-1e7, 1e7) as f64 } else { 0.0 } }
+fn color(c: Rgb) -> peniko::Color { peniko::Color::from_rgba8(c[0], c[1], c[2], 255) }
+fn rect(x: f32, y: f32, w: f32, h: f32) -> Rect {
+    Rect::new(scalar(x), scalar(y), scalar(x) + scalar(w), scalar(y) + scalar(h))
+}
+fn resolve(font: Font) -> wordcraft_fonts::word::Resolved {
+    let i = font.index();
+    let family = match i / 4 { 1 => "Times New Roman", 2 => "Courier New", _ => "Arial" };
+    wordcraft_fonts::word::resolve(family, i % 4 == 1 || i % 4 == 3, i % 4 >= 2)
+}
+fn coverage_optional(c: char) -> bool {
+    c.is_whitespace() || c.is_control() || matches!(c, '\u{200c}' | '\u{200d}' | '\u{fe0e}' | '\u{fe0f}' | '\u{ad}')
+}
+struct Run {
+    face: FaceRef,
+    glyphs: Vec<vello_cpu::Glyph>,
+    bold: bool,
+    italic: bool,
+}
+struct Text {
+    runs: Vec<Run>,
+    width: f32,
+}
+
+// Font spans preserve grapheme clusters (including emoji selectors/ZWJ). Bidi supplies
+// visual span order; the pinned shaper supplies ligatures and mark positions. Its public
+// API returns clusters in logical order, so RTL clusters are reordered as a unit here.
+fn shape(font: Font, size: f32, text: &str) -> Option<Text> {
+    if text.len() > MAX_TEXT_BYTES { return None; }
+    let size = if size.is_finite() { size.clamp(0.0, 10_000.0) } else { 0.0 };
+    let primary = resolve(font);
+    let db = FontDb::global();
+    let bidi = BidiInfo::new(text, None);
+    let mut runs = Vec::new();
+    let mut x = 0.0f32;
+    for paragraph in &bidi.paragraphs {
+        let (levels, visual) = bidi.visual_runs(paragraph, paragraph.range.clone());
+        for range in visual {
+            let rtl = levels.get(range.start).is_some_and(|l| l.is_rtl());
+            let Some(sub) = text.get(range) else { continue };
+            let mut spans: Vec<(usize, usize, FaceRef)> = Vec::new();
+            for (start, grapheme) in sub.grapheme_indices(true) {
+                let face = grapheme.chars().find(|c| !coverage_optional(*c) && !primary.face.covers(*c))
+                    .and_then(|c| db.fallback_for(c, primary.face.id()))
+                    .map(|f| FaceRef::of(&f)).unwrap_or(primary.face);
+                let end = start + grapheme.len();
+                if let Some(last) = spans.last_mut().filter(|s| s.2.id() == face.id()) { last.1 = end; }
+                else { spans.push((start, end, face)); }
+            }
+            if rtl { spans.reverse(); }
+            for (start, end, face) in spans {
+                let Some(span) = sub.get(start..end) else { continue };
+                let mut shaped = wordcraft_fonts::shape(&face, span, &[], |c| c);
+                if rtl { shaped.sort_by(|a, b| b.cluster.cmp(&a.cluster)); }
+                let k = size / face.upem.max(1.0) as f32;
+                let mut glyphs = Vec::with_capacity(shaped.len());
+                for g in shaped {
+                    glyphs.push(vello_cpu::Glyph { id: g.gid, x: x + g.x_offset as f32 * k, y: -g.y_offset as f32 * k });
+                    x += g.x_advance as f32 * k;
+                }
+                let is_primary = face.id() == primary.face.id();
+                runs.push(Run { face, glyphs, bold: is_primary && primary.synth_bold, italic: is_primary && primary.synth_italic });
+            }
+        }
+    }
+    Some(Text { runs, width: x })
+}
+
+pub(super) struct RasterPage {
+    ctx: RenderContext,
+    resources: Resources,
+    fonts: HashMap<u32, peniko::FontData>,
+    view: Affine,
+    width: u32,
+    height: u32,
+    clips: usize,
+    saved: Vec<usize>,
+    used: usize,
+    error: Option<&'static str>,
+}
+impl RasterPage {
+    pub(super) fn new(width: u32, height: u32, scale: f64) -> Result<Self, String> {
+        if width == 0 || height == 0 || width > 2800 || height > 2800 || u64::from(width) * u64::from(height) > 8_000_000
+            || !scale.is_finite() || scale <= 0.0 || scale > 4.0 {
+            return Err("Worksheet raster dimensions exceed the visual reader limit".into());
+        }
+        let mut ctx = RenderContext::new_with(width as u16, height as u16,
+            vello_cpu::RenderSettings { num_threads: 0, ..Default::default() });
+        ctx.set_paint(color([255, 255, 255]));
+        ctx.fill_rect(&Rect::new(0.0, 0.0, width as f64, height as f64));
+        Ok(Self { ctx, resources: Resources::new(), fonts: HashMap::new(), view: Affine::scale(scale),
+            width, height, clips: 0, saved: Vec::new(), used: 0, error: None })
+    }
+    fn reserve(&mut self, bytes: usize) -> bool {
+        if self.error.is_some() { return false; }
+        match self.used.checked_add(bytes).filter(|n| *n <= MAX_PAGE_CONTENT) {
+            Some(n) => { self.used = n; true }
+            None => { self.error = Some("Worksheet raster drawing budget exceeded"); false }
+        }
+    }
+    pub(super) fn measure(font: Font, size: f32, text: &str) -> f32 {
+        shape(font, size, text).map(|t| t.width).unwrap_or(f32::INFINITY)
+    }
+    pub(super) fn save(&mut self) {
+        if !self.reserve(64) { return; }
+        if self.saved.len() >= 4096 { self.error = Some("Worksheet raster graphics-state limit"); return; }
+        self.saved.push(self.clips);
+    }
+    pub(super) fn restore(&mut self) {
+        if let Some(n) = self.saved.pop() { while self.clips > n { self.ctx.pop_layer(); self.clips -= 1; } }
+    }
+    pub(super) fn clip_rect(&mut self, x: f32, y: f32, w: f32, h: f32) {
+        if !self.reserve(256) { return; }
+        if self.clips >= 4096 { self.error = Some("Worksheet raster clipping limit"); return; }
+        self.ctx.set_transform(self.view);
+        self.ctx.push_clip_layer(&rect(x, y, w.max(0.0), h.max(0.0)).to_path(0.1));
+        self.clips += 1;
+    }
+    pub(super) fn fill_rect(&mut self, x: f32, y: f32, w: f32, h: f32, c: Rgb) {
+        if w <= 0.0 || h <= 0.0 || !self.reserve(256) { return; }
+        self.ctx.set_transform(self.view); self.ctx.set_paint(color(c));
+        self.ctx.fill_rect(&rect(x, y, w, h));
+    }
+    fn stroke(&mut self, path: &BezPath, c: Rgb, width: f32, dash: &[f32], round: bool) {
+        let mut s = Stroke::new(scalar(width).max(0.0)).with_caps(Cap::Butt)
+            .with_join(if round { Join::Round } else { Join::Miter }).with_miter_limit(10.0);
+        let d: Vec<f64> = dash.iter().take(8).map(|v| scalar(*v).max(0.0)).collect();
+        if d.iter().any(|v| *v > 0.0) { s = s.with_dashes(0.0, d); }
+        self.ctx.set_transform(self.view); self.ctx.set_paint(color(c)); self.ctx.set_stroke(s); self.ctx.stroke_path(path);
+    }
+    pub(super) fn rect_stroke(&mut self, x: f32, y: f32, w: f32, h: f32, width: f32, c: Rgb) {
+        if !self.reserve(256) { return; }
+        self.stroke(&rect(x, y, w, h).to_path(0.1), c, width, &[], false);
+    }
+    pub(super) fn stroke_line_dashed(&mut self, x0: f32, y0: f32, x1: f32, y1: f32, width: f32, c: Rgb, dash: &[f32]) {
+        if !self.reserve(256) { return; }
+        let mut path = BezPath::new(); path.move_to((scalar(x0), scalar(y0))); path.line_to((scalar(x1), scalar(y1)));
+        self.stroke(&path, c, width, dash, false);
+    }
+    fn points(pts: &[[f32; 2]], close: bool) -> BezPath {
+        let mut path = BezPath::new();
+        for (i, p) in pts.iter().enumerate() {
+            let xy = (scalar(p[0]), scalar(p[1]));
+            if i == 0 { path.move_to(xy); } else { path.line_to(xy); }
+        }
+        if close { path.close_path(); } path
+    }
+    pub(super) fn polyline(&mut self, pts: &[[f32; 2]], width: f32, c: Rgb, dash: &[f32]) {
+        if pts.len() < 2 || !self.reserve(pts.len().saturating_mul(128)) { return; }
+        self.stroke(&Self::points(pts, false), c, width, dash, true);
+    }
+    fn fill_stroke(&mut self, path: &BezPath, fill: Option<Rgb>, stroke: Option<(Rgb, f32)>, round: bool) {
+        if let Some(c) = fill { self.ctx.set_transform(self.view); self.ctx.set_paint(color(c)); self.ctx.fill_path(path); }
+        if let Some((c, width)) = stroke { self.stroke(path, c, width, &[], round); }
+    }
