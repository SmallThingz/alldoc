+#[test]
+fn hidden_points_do_not_shift_other_series_or_numeric_coordinates() {
+    use gridcraft_model::{LineInfo, Sheet};
+    let mut wb = Workbook::new();
+    wb.sheets.push(Arc::new(Sheet::new("Other")));
+    for index in 0..2 {
+        let sh = wb.sheet_mut(index).unwrap();
+        for row in 0..3 {
+            sh.set_value(CellRef::new(row, 0), Value::Number((row + 1) as f64));
+            sh.set_value(CellRef::new(row, 1), Value::Number((row + 10) as f64));
+        }
+        sh.rows.insert(index as u32, LineInfo { hidden: true, ..Default::default() });
+    }
+    let mut c = chart(ChartKind::Bubble);
+    c.series = ["Sheet1", "Other"].into_iter().map(|name| Series {
+        name: None, categories: Some(format!("{name}!A1:A3")), values: format!("{name}!B1:B3"),
+        bubble_sizes: Some(format!("{name}!A1:A3")), color: None, secondary: false, kind: None,
+    }).collect();
+    let data = resolve(&wb, 0, &c);
+    assert_eq!(data.series[0].values, [None, Some(11.0), Some(12.0)]);
+    assert_eq!(data.series[1].values, [Some(10.0), None, Some(12.0)]);
+    assert_eq!(data.series[0].x, Some(vec![Some(1.0), Some(2.0), Some(3.0)]));
+    // With one series, a hidden point is removed from values, X and sizes together.
+    c.series.truncate(1);
+    let one = resolve(&wb, 0, &c);
+    assert_eq!(one.series[0].values, [Some(11.0), Some(12.0)]);
+    assert_eq!(one.series[0].x, Some(vec![Some(2.0), Some(3.0)]));
+    assert_eq!(one.series[0].sizes, Some(vec![Some(2.0), Some(3.0)]));
+}
