+#[cfg(feature = "raster")]
+#[test]
+fn raster_clip_restore_and_straight_alpha_keep_page_geometry() -> Result<(), String> {
+    let mut doc = PdfDoc::new_raster(64, 64, 1.0)?;
+    let pg = doc.add_page(64.0, 64.0);
+    pg.fill_rect(0.0, 0.0, 64.0, 64.0, [255, 0, 0]);
+    pg.save(); pg.clip_rect(8.0, 8.0, 16.0, 16.0);
+    pg.fill_rect(0.0, 0.0, 64.0, 64.0, [0, 0, 255]); pg.restore();
+    pg.fill_rect(32.0, 8.0, 16.0, 16.0, [0, 255, 0]);
+    pg.image_rgba(8.0, 32.0, 16.0, 8.0, &[0, 0, 255, 128], 1, 1);
+    let image = doc.finish_raster()?;
+    let pixel = |x: usize, y: usize| &image.pixels[(y * 64 + x) * 4..(y * 64 + x) * 4 + 4];
+    assert_eq!(pixel(2, 2), &[255, 0, 0, 255]);
+    assert_eq!(pixel(12, 12), &[0, 0, 255, 255]);
+    assert_eq!(pixel(36, 12), &[0, 255, 0, 255]);
+    let alpha = pixel(12, 36);
+    assert!((126..=128).contains(&alpha[0]) && alpha[1] == 0 && (127..=129).contains(&alpha[2]) && alpha[3] == 255);
+    Ok(())
+}
