+mod visibility_tests {
+    use super::*;
+
+    #[test]
+    fn visible_only_flag_defaults_and_roundtrips() {
+        for (flag, hidden) in [("", false), ("<plotVisOnly/>", false),
+            ("<plotVisOnly val=\"1\"/>", false), ("<plotVisOnly val=\"true\"/>", false),
+            ("<plotVisOnly val=\"0\"/>", true), ("<plotVisOnly val=\"false\"/>", true)] {
+            let xml = format!("<chartSpace><chart><plotArea><barChart/></plotArea>{flag}</chart></chartSpace>");
+            let chart = read_chart(&crate::xml::parse(xml.as_bytes()).unwrap()).unwrap();
+            assert_eq!(chart.show_hidden_data, hidden, "{flag}");
+            let output = write_chart(&Workbook::new(), 0, &chart);
+            let again = read_chart(&crate::xml::parse(output.as_bytes()).unwrap()).unwrap();
+            assert_eq!(again.show_hidden_data, hidden, "{flag}");
+        }
+    }
