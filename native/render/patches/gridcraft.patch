+#[test]
+fn hidden_chart_sources_keep_categories_gaps_and_palette_aligned() {
+    use gridcraft_model::{DefinedName, LineInfo};
+    let mut wb = Workbook::new();
+    let sh = wb.sheet_mut(0).unwrap();
+    for row in 0..4 {
+        sh.set_value(CellRef::new(row, 0), Value::from(format!("Label{row}")));
+        for col in 1..4 { sh.set_value(CellRef::new(row, col), Value::Number((col * 10 + row) as f64)); }
+    }
+    sh.set_value(CellRef::new(3, 1), Value::Empty);
+    sh.rows.insert(1, LineInfo { hidden: true, ..Default::default() });
+    sh.cols.insert(2, LineInfo { hidden: true, ..Default::default() });
+    wb.names.push(DefinedName { name: "SavedValues".into(), scope: None,
+        formula: "Sheet1!$B$1:$B$4".into(), comment: String::new(), hidden: false });
+    let mut c = chart(ChartKind::ColumnClustered);
+    c.series = ["SavedValues", "Sheet1!C1:C4", "Sheet1!D1:D4"].into_iter().map(|values| Series {
+        name: None, categories: Some("Sheet1!A1:A4".into()), values: values.into(),
+        bubble_sizes: None, color: None, secondary: false, kind: None,
+    }).collect();
+    let data = resolve(&wb, 0, &c);
+    assert_eq!(data.categories, ["Label0", "Label2", "Label3"]);
+    assert_eq!(data.series.len(), 2);
+    assert_eq!(data.series[0].values, [Some(10.0), Some(12.0), None]);
+    assert_eq!(data.series[1].values, [Some(30.0), Some(32.0), Some(33.0)]);
+    assert_eq!(data.series[1].name, "Series3");
+    assert_eq!(data.series[1].color, series_color(&wb.theme, 2));
+    c.show_hidden_data = true;
+    let all = resolve(&wb, 0, &c);
+    assert_eq!(all.series.len(), 3);
+    assert_eq!(all.categories, ["Label0", "Label1", "Label2", "Label3"]);
+    assert_eq!(all.series[1].values, [Some(20.0), Some(21.0), Some(22.0), Some(23.0)]);
+}
