+#[cfg(test)]
+mod reader_cache_tests {
+    use super::*;
+
+    #[test]
+    fn sparse_rule_statistics_keep_far_cells_and_are_reused() {
+        let mut workbook = Workbook::new();
+        let sheet = workbook.sheet_mut(0).unwrap();
+        sheet.set_value(CellRef::new(0, 0), Value::Number(1.0));
+        sheet.set_value(CellRef::new(12_000, 500), Value::Number(9.0));
+        sheet.cond_formats.push(CondFormat {
+            ranges: vec![RangeRef::new(CellRef::new(0, 0), CellRef::new(16_383, 511))],
+            rule: CfRule::ColorScale { stops: vec![(CfValueKind::Min, Color::Rgb(0xff0000)),
+                (CfValueKind::Max, Color::Rgb(0x0000ff))] }, priority: 0, stop_if_true: false,
+        });
+        let mut cache = CfCache::new();
+        assert_eq!(cache.look(&workbook, 0, CellRef::new(12_000, 500)).unwrap().scale_fill, Some([0, 0, 255]));
+        let pointer = cache.stats[&0].sorted.as_ptr();
+        for _ in 0..16 {
+            assert_eq!(cache.look(&workbook, 0, CellRef::new(0, 0)).unwrap().scale_fill, Some([255, 0, 0]));
+            assert_eq!(cache.stats.len(), 1);
+            assert!(cache.stats[&0].counts.is_empty());
+            assert_eq!(cache.stats[&0].sorted.as_ptr(), pointer);
+            assert_eq!(cache.stats[&0].sorted, vec![1.0, 9.0]);
+        }
+    }
+
+    #[test]
+    fn scalar_rules_use_saved_values_and_skip_expressions() {
+        let mut workbook = Workbook::new();
+        let sheet = workbook.sheet_mut(0).unwrap();
+        sheet.set_value(CellRef::new(0, 0), Value::Number(5.0));
+        let mut style = Style::default(); style.font.bold = true;
+        sheet.cond_formats.push(CondFormat { ranges: vec![RangeRef::cell(CellRef::new(0, 0))],
+            rule: CfRule::CellIs { op: CfOperator::Greater, a: "3".into(), b: None, style: Box::new(style) },
+            priority: 0, stop_if_true: false });
+        let mut cache = CfCache::new();
+        assert!(cache.look(&workbook, 0, CellRef::new(0, 0)).unwrap().style.unwrap().font.bold);
+        assert!(cache.stats.is_empty());
+        workbook.sheet_mut(0).unwrap().cond_formats[0].rule = CfRule::Expression {
+            formula: "1=1".into(), style: Box::new(Style::default()) };
+        assert!(cache.look(&workbook, 0, CellRef::new(0, 0)).is_none());
+    }
