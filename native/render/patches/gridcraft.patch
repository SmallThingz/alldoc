+#[cfg(feature = "raster")]
+#[test]
+fn raster_unicode_glyph_and_measurement_do_not_use_winansi_question_mark() -> Result<(), String> {
+    let face = wordcraft_fonts::word::resolve("Times New Roman", false, false).face;
+    assert!(face.covers('Ω'), "pinned serif face must carry the Greek fixture glyph");
+    let glyphs = wordcraft_fonts::shape(&face, "Ω", &[], |c| c);
+    assert!(!glyphs.is_empty() && glyphs.iter().all(|g| g.gid != 0));
+    assert_ne!(face.glyph_for('Ω'), face.glyph_for('?'));
+    let expected_width: f32 = glyphs.iter().map(|g| g.x_advance as f32).sum::<f32>() * 32.0 / face.upem as f32;
+    let render = |text: &str| -> Result<RasterImage, String> {
+        let mut doc = PdfDoc::new_raster(128, 64, 1.0)?;
+        let pg = doc.add_page(128.0, 64.0);
+        if text == "Ω" { assert!((pg.text_width(Font::TimesRoman, 32.0, text) - expected_width).abs() < 0.001); }
+        pg.text(8.0, 42.0, 32.0, Font::TimesRoman, [0, 0, 0], text);
+        doc.finish_raster()
+    };
+    let greek = render("Ω")?;
+    let question = render("?")?;
+    assert_eq!((greek.width, greek.height), (128, 64));
+    assert_ne!(greek.pixels, question.pixels, "Unicode must not take the former CP1252 '?' route");
+    let dark: Vec<(usize, usize)> = greek.pixels.chunks_exact(4).enumerate()
+        .filter(|(_, p)| p[0] < 128 && p[1] < 128 && p[2] < 128)
+        .map(|(i, _)| (i % 128, i / 128)).collect();
+    assert!(dark.len() > 16, "known glyph must render, not just differ from a question mark");
+    assert!(dark.iter().all(|(x, y)| *x >= 7 && *x < 48 && *y >= 8 && *y < 44), "glyph stays in its baseline geometry");
+    Ok(())
+}
